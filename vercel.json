{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/ads.txt", "destination": "/ads.txt" },
    { "source": "/avis", "destination": "/avis.html" },
    { "source": "/avis/", "destination": "/avis.html" },
    { "source": "/avis-admin", "destination": "/avis-admin.html" },
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/admin/", "destination": "/admin.html" },
    { "source": "/fr/questions-reponses", "destination": "/fr/questions-reponses/" },
    { "source": "/en/questions-answers", "destination": "/en/questions-answers/" },
    { "source": "/((?!api/|assets/|game-art/|mascot/|marketing/|chest/|brand/|fonts/|qa/|fr/|en/|logo\\.png|logo-128\\.png|icon-192\\.png|icon-512\\.png|icon-maskable-512\\.png|favicon\\.svg|favicon-32\\.png|logo\\.svg|manifest\\.json|sw\\.js|ads\\.txt|llms\\.txt|privacy\\.html|terms\\.html|avis\\.html|avis-admin\\.html|admin\\.html|robots\\.txt|sitemap\\.xml).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/index.html",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }]
    },
    {
      "source": "/",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }]
    },
    {
      "source": "/avis.html",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }]
    },
    {
      "source": "/admin.html",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/sw.js",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }]
    }
  ]
}
